 {
  "categories": [
   "compliance-management",
   "productivity-suite",
   "test-management",
   "it-development"
  ],
  "country": "PT",
  "desc_en": "AccessMonitor is an evaluation tool of the web content accessibility practices according to the WCAG 2.1 of W3C ",
  "desc_lang": "en",
  "dev_status": "development",
  "entry_url": "https://github.com/amagovpt/AccessMonitor",
  "fallback_repo": "https://github.com/amagovpt/AccessMonitor",
  "features": [
   "Generates a score from 1 to 10. How much are the accessibility practices found on the submitted web page worth?",
   "Generates a report containing the good and the bad practices found on the submitted web page.",
   "Evaluates a web page by submitting a URL, directly entering code, or uploading a file.",
   "It is also available as an extension for Chrome/Edge which allows you to perform evaluations even on pages under login.",
   "Evaluates WCAG 2.1 standard (includes all ACT Rules)."
  ],
  "is_fork": false,
  "last_activity": "2026-06-22T03:52:33Z",
  "license": "MIT",
  "long_desc": "Does your website or digital service comply with European Standard EN 301 549? Does it meet the accessibility standards of the Accessibility Directive and the European Accessibility Act? AccessMonitor provides a first look at these questions. The automatic assessment of accessibility practices doesn't answer everything, but it's a good starting point. More than a police officer, AccessMonitor aims to be your educator of accessibility requirements. It reports errors, but also tells you what it found to be well-executed and what requires manual validation.",
  "maintenance": "contract",
  "name": "AccessMonitor",
  "platforms": [
   "web"
  ],
  "released": "2025-07-09",
  "repo": "https://github.com/amagovpt/AccessMonitor",
  "repo_key": "github.com/amagovpt/accessmonitor",
  "short_desc": "AccessMonitor is an evaluation tool of the web content accessibility practices according to the WCAG 2.1 of W3C ",
  "software_type": "standalone/web",
  "source": "PT/arte",
  "stars": 26,
  "tier": "publiccode",
  "used_by": [
   "ARTE, I.P. - State Technological Reform Agency (Portugal), Monitoring authority of the Accessibility Directive.",
   "The tool support the monitoring of all public administration in Portugal."
  ],
  "version": "v.3.0.1"
 },
