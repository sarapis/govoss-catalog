  "country": "SE",
  "desc_en": "A linting tool for the swedish rest api-profile specification",
  "desc_lang": "en",
  "dev_status": "beta",
  "entry_url": "https://github.com/diggsweden/rest-api-profil-lint-processor",
  "fallback_repo": "https://github.com/diggsweden/rest-api-profil-lint-processor",
  "features": [
   "Schema validation",
   "Ensure adherence to OpenAPI standards",
   "Missing attributes check",
   "Detect missing or misconfigured attributes in specifications"
  ],
  "is_fork": false,
  "last_activity": "2026-09-24T08:14:59Z",
  "license": "EUPL-1.2",
  "long_desc": "RAP-LP (REST API Profile Lint Processor) is a tool that reviews an OpenAPI specification against the national REST API Profile. The tool identifies syntax errors and deviations from the guidelines, making it easier to quickly find and correct issues.\nThe tool analyzes the OpenAPI specification and checks that the API follows specific design rules associated with the REST API Profile. Each rule points to a specific part of the OpenAPI specification using a JSON Path Plus expression and verifies whether the values comply with the established rules. If deviations are found, one or more error messages are returned.\nIn addition to the rules from the REST API Profile, RAP-LP also includes a rule area called Prerequisites. This area encompasses additional rules not included in the profile but based on established best practices for API design. The rules in Prerequisites can help further improve the quality of the API specification by identifying areas for improvement not covered by the national profile.\nThe first version of RAP-LP is compatible with REST API Profile version 1.2.0, and each new version of the tool will specify which version of the profile it is intended to support.\n",
  "maintenance": "internal",
  "name": "REST API-profil - Lint Processor (RAP-LP)",
  "platforms": [
   "windows",
   "mac",
   "linux"
  ],
  "released": "2025-05-17",
  "repo": "https://github.com/diggsweden/rest-api-profil-lint-processor.git",
  "repo_key": "github.com/diggsweden/rest-api-profil-lint-processor",
  "short_desc": "A linting tool for the swedish rest api-profile specification",
  "software_type": "library",
  "source": "SE/digg",
  "stars": 7,
  "tier": "publiccode",
  "version": "1.0.0"
 },
