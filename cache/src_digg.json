  "desc_en": "Converts and validates API descriptions into DCAT-AP-SE metadata as RDF",
  "desc_lang": "en",
  "dev_status": "beta",
  "entry_url": "https://github.com/diggsweden/DCAT-AP-SE-Processor",
  "fallback_repo": "https://github.com/diggsweden/DCAT-AP-SE-Processor",
  "features": [
   "Generation of DCAT-AP-SE metadata as RDF from an existing API description",
   "Support for YAML, RAML and JSON input formats",
   "Validates input against DCAT-AP-SE specification",
   "Web interface for interactive use",
   "REST API for use in automated publishing pipelines",
   "Runs interactively or as a step in a CI/CD pipeline"
  ],
  "is_fork": false,
  "last_activity": "2026-09-23T10:55:08Z",
  "license": "EUPL-1.2",
  "long_desc": "DCAT-AP-SE Processor generates metadata that conforms to the Swedish\napplication profile DCAT-AP-SE, the profile used to describe datasets and\ndata services published by Swedish public administrations.\n\nThe tool reads an existing API description in YAML, RAML or JSON format and\nproduces an RDF representation of it according to the profile. This means\nthe metadata is derived from the API description that already exists,\nrather than being written and maintained by hand as a separate artefact,\nwhich reduces the risk of the two drifting apart over time.\n\nThe tool is available as a web interface, REST API or CLI, and can be\nused interactively or run as a step in an existing publishing pipeline.\n",
  "maintenance": "internal",
  "name": "DCAT-AP-SE Processor",
  "platforms": [
   "windows",
   "web",
   "linux"
  ],
  "released": "2022-10-01",
  "repo": "https://github.com/diggsweden/DCAT-AP-SE-Processor",
  "repo_key": "github.com/diggsweden/dcat-ap-se-processor",
  "short_desc": "Converts and validates API descriptions into DCAT-AP-SE metadata as RDF",
  "software_type": "standalone/web",
  "source": "SE/digg",
  "stars": 11,
