# ---- credentials. This repo is PUBLIC.
# run.sh reads a Vercel token from $VERCEL_TOKEN or ~/.config/govoss/vercel-token,
# and harvest/liveness read $GITHUB_TOKEN and $NL_API_KEY. None of them belong in
# the tree, and a token that lands here is public the moment it is pushed —
# GitHub push protection is a backstop, not the plan.
.env
.env.*
*.pem
*.key
vercel-token
.vercel/
.netrc
secrets.json

# local scratch — design handoffs, working files. Never committed.
_scratch/
