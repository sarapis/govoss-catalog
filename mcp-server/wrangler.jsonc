{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "govoss-mcp",
  // Pinned so a cached login for another account cannot redirect the deploy:
  // the first move failed because node_modules/.cache/wrangler pointed at the
  // itspruvn.com account. This is Devin@sarapis.org's Account.
  "account_id": "a8e2fa072ede7a6389e8db8cad00f774",
  // The permanent address, independent of which account's workers.dev
  // subdomain the Worker happens to live under. workers.dev stays on too.
  "routes": [{ "pattern": "mcp.govoss.cat", "custom_domain": true }],
  "workers_dev": true,
  "main": "src/index.js",
  "compatibility_date": "2025-07-01",

  // NO Durable Objects, NO KV, NO OAuth, unlike the tasks-mcp worker next door.
  // This server is public, keyless and stateless: it answers from static JSON
  // that anyone can already fetch, so there is no session to keep and no secret
  // to hold. Every binding omitted here is one that cannot misconfigure.
  "vars": {
    // Read from the published site, not from a private copy. The server
    // therefore has no privileged access and cannot serve anything the public
    // data does not contain.
    "CATALOG_ORIGIN": "https://govoss-catalog.vercel.app"
  },

  "observability": { "enabled": true }
}
